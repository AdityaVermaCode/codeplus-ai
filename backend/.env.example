# CodePulse AI — Backend Environment Variables
# Copy this file to .env and fill in your values.
# (.env is gitignored — your keys will NOT be committed to GitHub)

# ── LM Studio (Local AI) ──────────────────────────────────────────────────────
# Default port for LM Studio's local server. Leave this as-is unless you
# changed LM Studio's port manually.
LM_STUDIO_URL=http://localhost:1234/v1/chat/completions

# ── Google Gemini API (Cloud Fallback) ────────────────────────────────────────
# Only needed if LM Studio is not running. Get a free key at:
# https://aistudio.google.com/apikey
# Leave blank if you don't need the cloud fallback.
GEMINI_API_KEY=
